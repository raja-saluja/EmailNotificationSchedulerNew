    	  type="System.Data.Entity.Internal.ConfigFile.EntityFrameworkSection, EntityFramework, Version=6.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089"
    	  requirePermission="false"/>
	  </configSections>

  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8"/>
  </startup>
    <connectionStrings>
        <add name="ERPNaqelEntities"
            connectionString="metadata=res://*/Model1.csdl|res://*/Model1.ssdl|res://*/Model1.msl;provider=System.Data.SqlClient;provider connection string=&quot;data source=212.107.109.124;initial catalog=ERPNaqel;persist security info=True;user id=dbuser;password=Appuser@123;MultipleActiveResultSets=True;App=EntityFramework&quot;"
            providerName="System.Data.EntityClient"/>
        <add name="ERPNaqelEntities1"
            connectionString="metadata=res://*/Model2.csdl|res://*/Model2.ssdl|res://*/Model2.msl;provider=System.Data.SqlClient;provider connection string=&quot;data source=10.1.8.118;initial catalog=ERPNaqel;persist security info=True;user id=testuser;password=Test@123;MultipleActiveResultSets=True;App=EntityFramework&quot;"
            providerName="System.Data.EntityClient"/>
