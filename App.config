  <appSettings>
    <add key="Myemail" value="Nouf.alotaibi@naqel.com.sa"/>
    <add key="MailName" value="no.reply@naqel.com.sa"/>
    <add key="MailUserName" value="no.reply@naqel.com.sa"/>
    <add key="MailPwd" value="smazqlnztxdesmif"/>
    <add key="SMTPClientHost" value="smtp-relay.gmail.com"/>
    <add key="SMTPClientPort" value="587"/>
    <add key="DLHTML" value="D:\\2023\\NotificationsWebsite"/>
    <add key="ClientSettingsProvider.ServiceUri" value=""/>
